# Copy to .env locally. Railway sets these in the dashboard.

# Shopify (Partners → App → Client credentials)
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=
# Railway currently uses these names — both work in code:
# SHOPIFY_CLIENT_ID=
# SHOPIFY_CLIENT_SECRET=

SCOPES=read_products,write_products,read_content,write_content,read_locales,read_markets,read_themes,write_themes,read_locations,read_metaobject_definitions,write_metaobject_definitions,read_metaobjects,write_metaobjects

# Production: https://your-service.up.railway.app (no trailing slash)
SHOPIFY_APP_URL=

# Railway Postgres (Variables → DATABASE_URL, or reference from Postgres service)
DATABASE_URL=

# AI plan (step 3)
GEMINI_API_KEY=

# Pilot: skip $35 billing. Remove or set false when charging.
BILLING_DISABLED=true

NODE_ENV=production
