# Railway production checklist (PredictaSEO-Core service)
# DATABASE_URL     → reference from Postgres service
# SHOPIFY_APP_URL  → https://predictaseo-core-production.up.railway.app
# SHOPIFY_CLIENT_ID / SHOPIFY_CLIENT_SECRET (or SHOPIFY_API_KEY / SHOPIFY_API_SECRET)
# GEMINI_API_KEY
# SCOPES           → same line as shopify.app.toml
# NODE_ENV         → production
# BILLING_DISABLED → true (pilot)

# Shopify (Partners → App → Client credentials) — BOTH required in Railway
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=
# Railway often uses these names instead:
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=

SCOPES=read_products,write_products,read_content,write_content,read_locales,read_markets,read_themes,write_themes,read_locations,read_metaobject_definitions,write_metaobject_definitions,read_metaobjects,write_metaobjects

# Production: https://your-service.up.railway.app (no trailing slash)
SHOPIFY_APP_URL=

# Railway Postgres (Variables → DATABASE_URL, or reference from Postgres service)
DATABASE_URL=

# AI plan (step 3)
GEMINI_API_KEY=

# Pilot: skip $35 billing. Remove or set false when charging.
BILLING_DISABLED=true

NODE_ENV=production
