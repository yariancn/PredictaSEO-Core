# Railway production checklist (PredictaSEO-Core service)
# DATABASE_URL     → reference from Postgres service
# SHOPIFY_APP_URL  → https://predictaseo-core-production.up.railway.app
# SHOPIFY_CLIENT_ID / SHOPIFY_CLIENT_SECRET (or SHOPIFY_API_KEY / SHOPIFY_API_SECRET)
# GEMINI_API_KEY
# SCOPES           → same line as shopify.app.toml
# NODE_ENV         → production
# CRON_SECRET       → random secret for /cron/monthly-apply (Authorization: Bearer …)

# Pilot (custom distribution — one store, no App Store review)
# APP_DISTRIBUTION  → single_merchant
# SHOPIFY_APP_HANDLE → same as handle in shopify.app.pilot.toml (e.g. predictacore-pilot)

# Shopify (Partners → App → Client credentials) — BOTH required in Railway
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=
# Railway often uses these names instead:
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=

SCOPES=read_products,write_products,read_content,write_content,read_locales,write_translations,read_markets,read_themes,write_themes,read_locations,read_metaobject_definitions,write_metaobject_definitions,read_metaobjects,write_metaobjects,read_reports

# Production: https://your-service.up.railway.app (no trailing slash)
SHOPIFY_APP_URL=

# Local dev (SQLite). Production uses Postgres on Railway — see schema.postgres.prisma
DATABASE_URL="file:./dev.sqlite"

# AI plan (step 3)
GEMINI_API_KEY=

# Google Search Console OAuth (optional — organic impact panel)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Pilot: skip $35 billing. Remove or set false before App Store submission.
BILLING_DISABLED=true

# App Store review: use test charges on dev stores only.
# Set SHOPIFY_BILLING_TEST=true while testing billing on a development store.
# SHOPIFY_BILLING_TEST=true

NODE_ENV=production
